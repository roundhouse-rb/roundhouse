#!/usr/bin/env ruby
# scripts/app-suite-summary — turn a scripts/app-suite run into the
# machine-readable report the published page is rendered from.
#
# The sibling of the JSON half of scripts/lobsters-specs. That script
# runs the suite and writes its own summary.json because it is Ruby all
# the way down; app-suite is bash, so the clustering lives here and
# `app-suite --json` calls it.
#
# SEPARATE SCRIPT, NOT INLINE, for one reason beyond tidiness: triage
# iterates. Editing bench/<app>/suite-causes.json and re-running this
# against a SAVED tally re-clusters a few hundred tests in a second, where
# re-running the suite costs a cargo build and four minutes. The tally is
# the run; this is a pure function of it.
#
# WHAT A "FAILURE" IS HERE. The app's suite is Minitest run by the emitted
# autorun shim, which reports per-test `FAIL <Class>#<test>: <msg>`
# lines — but only for files that LOAD. A file that dies at require time
# contributes its whole test count with no per-test message at all, and
# those are exactly the interesting ones. So the unit is an UNPASSED TEST
# (`total - passed` per file), attributed either to its own message or,
# for an aborted file, to the file's load error carrying the weight of
# every test that never ran. The cause counts cover the unpassed total
# MINUS the rows the join sets aside as environment; they are not a count
# of FAIL lines.
#
# THE ROW JOIN. `--baseline` is Rails' own run of the same suite
# (scripts/app-suite-baseline) and `--emit-tests` is what the emit
# generated and ran. Joined row by row, a test Rails passes that the emit
# never generated is DROPPED — no failure, no diagnostic, just a smaller
# denominator — and a test that fails on Rails too is ENV. Both are
# invisible in the tally alone. See `--baseline` below for the statuses.
#
# Usage:
#   scripts/app-suite-summary --tally FILE [options]
#
#   --tally FILE      the `STATUS|file|passed|total|first-error` table
#                     (required — it is the run)
#   --fail-log FILE   the `file|Class#test|msg|ExceptionClass|frame`
#                     per-test failures. Without it every unpassed test in
#                     a file is attributed to that file's first error,
#                     which over-credits the first wall; the JSON records
#                     which was used.
#   --emit-tests FILE the emitted tests the run generated and ran, one
#                     `Class#test|status` per line (status pass, fail or
#                     skip). app-suite writes it.
#   --baseline FILE   Rails' own run of the suite, one row per test. The
#                     join writes `rows`, `dropped`, `env` and `extra`;
#                     without it those are null. Default
#                     bench/<app>/rails-baseline.json when it exists.
#   --no-join REASON  skip the join and record REASON (app-suite passes
#                     it for --filter: a partial run against the whole
#                     baseline would call every filtered-out test dropped).
#   --emit-log FILE   the transpile's stderr, for the diagnostic counts
#   --app NAME        recipe bench/NAME/app.json (default campfire); it
#                     names the app and the causes file
#   --app-path DIR    the app checkout, for its SHA
#   --app-sha S       state the SHA directly (CI pins it and never clones
#                     a git tree — the tarball has no .git)
#   --target T        which lane produced the tally, `ruby` (default) or
#                     `spinel`. The page must say: the two lanes run the
#                     SAME emitted source through different runtimes, and
#                     only the compiled one can report a file that never
#                     linked (status `build`). On `spinel` the summary
#                     also records the COMPILER, read from the binary's
#                     own `--version` — it is the one input to that lane
#                     nobody here controls.
#   --stubs FILE      the spliced ledger when present (default path
#                     scripts/<app>-walk-stubs.rb; tip has none)
#   --no-stubs        the run spliced nothing
#   --out PATH        where to write (default build/app-suite/summary.json)

require "json"
require "time"
require "open3"

ROOT = File.expand_path("..", __dir__)

opts = {
  tally: nil, fail_log: nil, emit_tests: nil, baseline: nil, emit_log: nil,
  app: "campfire", app_path: nil, sha: nil, target: "ruby",
  stubs: :default,
  out: File.join(ROOT, "build", "app-suite", "summary.json"),
}
args = ARGV.dup
until args.empty?
  case (a = args.shift)
  when "--tally"        then opts[:tally] = args.shift
  when "--fail-log"     then opts[:fail_log] = args.shift
  when "--emit-tests"   then opts[:emit_tests] = args.shift
  when "--baseline"     then opts[:baseline] = args.shift
  when "--no-join"      then opts[:no_join] = args.shift
  when "--emit-log"     then opts[:emit_log] = args.shift
  when "--app"          then opts[:app] = args.shift
  when "--app-path"     then opts[:app_path] = args.shift
  when "--app-sha"      then opts[:sha] = args.shift
  when "--target"       then opts[:target] = args.shift
  when "--stubs"        then opts[:stubs] = args.shift
  when "--no-stubs"     then opts[:stubs] = false
  when "--out"          then opts[:out] = args.shift
  when "-h", "--help"
    puts File.readlines(__FILE__).drop(1).take_while { |l| l.start_with?("#") }.map { |l| l.sub(/^# ?/, "") }
    exit 0
  else abort "app-suite-summary: unknown argument #{a}"
  end
end
abort "app-suite-summary: --tally is required" unless opts[:tally]
abort "app-suite-summary: no tally at #{opts[:tally]}" unless File.exist?(opts[:tally])

RECIPE = File.join(ROOT, "bench", opts[:app], "app.json")
recipe = File.exist?(RECIPE) ? (JSON.parse(File.read(RECIPE)) rescue {}) : {}
CAUSES_FILE = File.join(ROOT, "bench", opts[:app], "suite-causes.json")
opts[:stubs] = File.join(ROOT, "scripts", "#{opts[:app]}-walk-stubs.rb") if opts[:stubs] == :default
# A baseline is only the default when it is there: a recipe with none is a
# run that cannot join, not a mistake.
default_baseline = File.join(ROOT, "bench", opts[:app], "rails-baseline.json")
opts[:baseline] = default_baseline if opts[:baseline].nil? && File.exist?(default_baseline)

def git(dir, *a)
  out, _, st = Open3.capture3("git", "-C", dir, *a)
  st.success? ? out.strip : nil
end

# THE COMPILER'S BYTES ARE NOT GUARANTEED UTF-8. A BUILD row's `why` is
# the first line of a failed compile, verbatim, and a toolchain is free
# to put a non-UTF-8 byte in it (a locale-specific message, a source
# fragment quoted mid-multibyte). `String#split` raises
# `ArgumentError: invalid byte sequence in UTF-8` on such a line and
# takes the whole summary with it — which is exactly how the first
# LINUX run of the spinel lane died AFTER its 19 minutes of compiles,
# having already written a perfectly good tally. The mac run of the
# same commit never hit it, so this is only reachable on the machine
# the lane is meant to be PUBLISHED from.
#
# `scrub` rather than a rescue: an undecodable byte in an error message
# must not lose the row, and the row is what the ledger counts.
def read_lines_scrubbed(path)
  File.read(path, encoding: "BINARY").force_encoding("UTF-8").scrub("?").lines
end

# ── The run ──────────────────────────────────────────────────────────
by_file = read_lines_scrubbed(opts[:tally]).filter_map do |line|
  line = line.chomp
  next if line.empty?
  status, file, passed, total, why = line.split("|", 5)
  { "file" => file.to_s, "status" => status.to_s.downcase,
    "tests" => total.to_i, "passed" => passed.to_i,
    "failed" => total.to_i - passed.to_i,
    # A file that failed with nothing passing and no per-test line ran
    # nothing at all — see the header. Marked here rather than inferred
    # by the renderer, which should not have to re-derive it.
    "first_error" => why.to_s.strip }
end
abort "app-suite-summary: tally at #{opts[:tally]} has no rows" if by_file.empty?

# ── Per-test failures ────────────────────────────────────────────────
fails_by_file = Hash.new { |h, k| h[k] = [] }
# Whether the LOG was kept, not whether it had lines: an all-green run
# has no failures to list, and reporting that as "no per-test
# attribution" would raise the page's alarm on the best possible result.
have_fail_log = !!(opts[:fail_log] && File.exist?(opts[:fail_log]))
if have_fail_log
  read_lines_scrubbed(opts[:fail_log]).each do |line|
    line = line.chomp
    next if line.empty?
    # `file|Class#test|msg|ExceptionClass|frame`. The message is field 3
    # and a failure message may itself contain `|`, so the exception and
    # frame are split off the END; -1 keeps a trailing empty field (the
    # spinel lane writes no frame).
    parts = line.split("|", -1)
    next if parts.size < 5
    fails_by_file[parts[0].to_s] << {
      "test" => parts[1].to_s, "msg" => parts[2...-2].join("|").strip,
      "exception" => parts[-2].to_s, "frame" => parts[-1].to_s,
    }
  end
end

# ── The join against Rails' own run ─────────────────────────────────
# The tally says what the emit did; only Rails' baseline says what the
# suite HAS. A test Rails passes that the emit never generated is
# DROPPED — the quietest gap there is, because there is no failure to
# count and the denominator quietly shrank. A test that fails on Rails
# too is ENV: the environment, not the compiler, and it must not be
# charged to a cause. The two sides are normalized the same way, because
# the emitter downcases and sanitizes Minitest's names
# (`test_loads_AVIF` -> `test_loads_avif`).
row_key = lambda do |name|
  klass, test = name.to_s.split("#", 2)
  norm = test.to_s.downcase.gsub(/[^a-z0-9]+/, "_").gsub(/\A_|_\z/, "")
  test.nil? ? norm : "#{klass}##{norm}"
end

emit_rows = {}
have_emit_tests = !!(opts[:emit_tests] && File.exist?(opts[:emit_tests]))
if have_emit_tests
  read_lines_scrubbed(opts[:emit_tests]).each do |line|
    line = line.chomp
    next if line.empty?
    name, status, file = line.split("|", 3)
    emit_rows[row_key.(name)] = { "name" => name, "status" => status.to_s, "file" => file }
  end
end

rows = nil
dropped = []
env = []
extra = []
env_keys = {}
baseline_meta = nil
if opts[:no_join]
  baseline_meta = { "note" => "Not joined: #{opts[:no_join]}" }
elsif opts[:baseline].nil?
  baseline_meta = {
    "note" => "No Rails baseline at bench/#{opts[:app]}/rails-baseline.json; the row join did not run.",
  }
elsif !File.exist?(opts[:baseline])
  abort "app-suite-summary: no baseline at #{opts[:baseline]}"
elsif !have_emit_tests
  baseline_meta = {
    "note" => "No --emit-tests for this run, so there is nothing to join the baseline to.",
  }
else
  baseline = JSON.parse(File.read(opts[:baseline]))
  baseline_meta = {
    "sha" => baseline["sha"], "rails" => baseline["rails"],
    "ruby" => baseline["ruby"], "generated_at" => baseline["generated_at"],
  }
  run_sha = opts[:sha] || (opts[:app_path] && git(opts[:app_path], "rev-parse", "HEAD"))
  # A checkout with uncommitted changes is not the tree its HEAD names.
  dirty = !opts[:sha] && opts[:app_path] && !git(opts[:app_path], "status", "--porcelain").to_s.empty?
  short = ->(s) { s.to_s.empty? ? "an unknown commit" : s.to_s[0, 12] }
  if baseline["dirty"]
    baseline_meta["note"] = "Not joined: the baseline was recorded from a checkout with uncommitted changes."
    warn "app-suite-summary: the baseline was recorded from a dirty checkout; writing rows: null"
  elsif dirty
    baseline_meta["note"] = "Not joined: the app checkout has uncommitted changes, so this run is not #{short.(run_sha)}."
    warn "app-suite-summary: #{opts[:app_path]} has uncommitted changes; writing rows: null"
  elsif baseline["sha"].to_s.empty? || run_sha.to_s.empty? || baseline["sha"] != run_sha
    # A join across two commits is a fabricated number: tests move, and
    # the answer would describe neither the baseline nor this emit.
    baseline_meta["note"] = "Not joined: the baseline is Rails' run at #{short.(baseline["sha"])}, " \
                            "this run is #{short.(run_sha)}."
    warn "app-suite-summary: baseline #{short.(baseline["sha"])} does not match this run " \
         "(#{short.(run_sha)}); writing rows: null"
  else
    counts = Hash.new(0)
    baseline_keys = {}
    Array(baseline["tests"]).each do |r|
      key = row_key.(r["name"])
      baseline_keys[key] = true
      emit = emit_rows[key]
      rails_status = r["status"].to_s
      status =
        if %w[fail error].include?(rails_status)
          "env"
        elsif rails_status == "skip" || (emit && emit["status"] == "skip")
          "skip"
        elsif emit.nil?
          "dropped"
        elsif emit["status"] == "pass"
          "match"
        else
          "gap"
        end
      counts[status] += 1
      env_keys[key] = true if status == "env"
      dropped << { "name" => r["name"], "file" => r["file"] } if status == "dropped"
      if status == "env"
        env << { "name" => r["name"], "exception" => r["exception"], "message" => r["message"] }
      end
    end
    # What the emit generated that Rails' suite does not have at all.
    (emit_rows.keys - baseline_keys.keys).each do |key|
      counts["extra"] += 1
      extra << emit_rows[key]["name"]
    end
    rows = %w[match gap dropped env skip extra].to_h { |k| [k, counts[k]] }
  end
end

# One record per UNPASSED test. A file whose per-test lines do not cover
# its unpassed count gets one record for the shortfall, carrying that
# weight and the file's first error — which for an aborted file is the
# load error and for a truncated one is the first wall.
records = []
by_file.each do |f|
  unpassed = f["failed"]
  next if unpassed <= 0
  listed = fails_by_file[f["file"]]
  # A file that requires another test file also prints that file's FAIL
  # lines. When the emitted list says which file owns each test, only
  # this file's own lines count against its unpassed number.
  if emit_rows.values.any? { |r| r["file"] }
    listed = listed.select { |t| emit_rows.dig(row_key.(t["test"]), "file").then { _1.nil? || _1 == f["file"] } }
  end
  # First-match the file's own unpassed count against its per-test lines,
  # THEN drop the env rows: the count already includes them, so filtering
  # before the match would turn them into a phantom shortfall record.
  listed.first(unpassed).each do |t|
    next if env_keys[row_key.(t["test"])]
    records << { "file" => f["file"], "test" => t["test"], "msg" => t["msg"],
                 "exception" => t["exception"], "frame" => t["frame"], "weight" => 1 }
  end
  # The shortfall is the tests that never printed a line of their own;
  # the ones Rails fails too are set aside here as well.
  listed_keys = listed.map { |t| row_key.(t["test"]) }
  # Only an env test that the emit also failed is in `unpassed`.
  env_unlisted = emit_rows.count do |k, r|
    r["file"] == f["file"] && env_keys[k] && r["status"] == "fail" && !listed_keys.include?(k)
  end
  short = unpassed - [listed.size, unpassed].min - env_unlisted
  next if short <= 0
  f["aborted"] = listed.empty?
  records << { "file" => f["file"],
               "test" => listed.empty? ? "(file did not run)" : "(#{short} more)",
               "msg" => f["first_error"], "weight" => short }
end

# ── Cluster into named causes ────────────────────────────────────────
rules = File.exist?(CAUSES_FILE) ? JSON.parse(File.read(CAUSES_FILE))["causes"] : []
buckets = Hash.new { |h, k| h[k] = [] }
unclassified = []
# `match` keys on the failure MESSAGE, which is the right key for anything
# that raised. A divergence has no message of its own — every wrong answer
# reads as an assertion failure — so a rule may also name the TEST, and
# then both have to hold. `match_frame` keys on where it was raised (the
# emitted `  at` line): one message ("constant not supported") raised in
# two places is two causes.
records.each do |r|
  rule = rules.find do |x|
    next false unless x["match"] && r["msg"] =~ Regexp.new(x["match"])
    next false unless x["match_test"].nil? || r["test"] =~ Regexp.new(x["match_test"])
    x["match_frame"].nil? || r["frame"].to_s =~ Regexp.new(x["match_frame"])
  end
  (rule ? buckets[rule["slug"]] : unclassified) << r
end

weigh = ->(rs) { rs.sum { |r| r["weight"] } }
unpassed_total = weigh.(records)
# Dropped tests are a different kind of debt from unpassed ones — nothing
# tried and failed, nothing was generated at all — but they belong on the
# same worklist, so shares are of everything either kind accounts for.
denominator = unpassed_total + dropped.size
sample = lambda do |rs, n|
  rs.first(n).map do |r|
    { "example" => "#{r["file"]} · #{r["test"]}",
      "error" => r["msg"].to_s[0, 200],
      "exception" => r["exception"].to_s, "frame" => r["frame"].to_s }
  end
end

causes = rules.map do |x|
  hits = buckets[x["slug"]]
  { "slug" => x["slug"], "title" => x["title"], "owner" => x["owner"],
    "failures" => weigh.(hits),
    "share" => denominator.zero? ? 0.0 : (weigh.(hits).to_f / denominator).round(4),
    "note" => x["note"],
    # A rule at zero is three different facts. Reporting them as one sent
    # a cause the STUB covers (belongs-to-autosave, whose note says so)
    # into the same footnote as a rule whose message drifted, where a
    # deliberate result reads as an unexplained one.
    "stale_rule" => hits.empty? && x["at_zero"].nil? && !x["stubbed"],
    "at_zero" => hits.empty? ? x["at_zero"] : nil,
    "stubbed_zero" => hits.empty? && !!x["stubbed"],
    "examples" => sample.(hits, 5) }
end.sort_by { |c| -c["failures"] }

# ── Dropped rows, clustered for the worklist ───────────────────────
# A directory the emit never ingests (test/integration, test/middleware)
# is one decision, so it is one cause; a class that exists on both sides
# but defines fewer emitted tests is a different one, so it clusters by
# FILE even though its siblings in the same directory are fine.
emit_classes = emit_rows.values.each_with_object({}) do |r, h|
  h[r["name"].to_s.split("#", 2)[0]] = true
end
dropped_groups = Hash.new { |h, k| h[k] = [] }
dropped.each do |d|
  klass = d["name"].to_s.split("#", 2)[0]
  key = emit_classes[klass] ? "dropped:#{d["file"]}" : "dropped:#{File.dirname(d["file"])}"
  dropped_groups[key] << d
end
causes += dropped_groups.map do |slug, list|
  where = slug.delete_prefix("dropped:")
  n = list.size
  if where.end_with?(".rb")
    title = "Rails runs #{n} test#{n == 1 ? "" : "s"} in #{where} that the emit never generated"
    note = "The class exists on both sides, but the emitted file defines fewer tests " \
           "(a loop-generated test is the usual case), so these never entered the denominator above. " \
           "They are not failures: nothing was attempted."
  else
    title = "Rails runs #{n} test#{n == 1 ? "" : "s"} under #{where}/ that the emit never generated"
    note = "The emit ingests no test file under #{where}/, so these tests never entered the " \
           "denominator above. They are not failures — nothing was attempted."
  end
  { "slug" => slug, "title" => title, "owner" => "compiler",
    "failures" => n,
    "share" => denominator.zero? ? 0.0 : (n.to_f / denominator).round(4),
    "note" => note, "stale_rule" => false, "at_zero" => nil, "stubbed_zero" => false,
    "examples" => list.first(5).map do |d|
      { "example" => "#{d["name"]} · #{d["file"]}",
        "error" => "the emit generated no test for it", "exception" => "", "frame" => "" }
    end }
end.sort_by { |c| -c["failures"] }
causes.sort_by! { |c| -c["failures"] }

# Untriaged is a first-class todo, not a rounding error: its size is how
# much of the failure surface nobody has looked at yet.
if unclassified.any?
  causes << {
    "slug" => "unclassified", "title" => "Not yet triaged", "owner" => "unknown",
    "failures" => weigh.(unclassified),
    "share" => denominator.zero? ? 0.0 : (weigh.(unclassified).to_f / denominator).round(4),
    "note" => "No rule in bench/#{opts[:app]}/suite-causes.json matches these. Triage, then add a rule.",
    "stale_rule" => false,
    "examples" => sample.(unclassified, 12),
  }
end

# ── Emit diagnostics ─────────────────────────────────────────────────
emit = {}
if opts[:emit_log] && File.exist?(opts[:emit_log])
  log = File.read(opts[:emit_log], encoding: "BINARY").force_encoding("UTF-8").scrub("?")
  diags = log.scan(/\b(error|warning)\[([a-z_]+)\]/)
  emit["errors"] = diags.count { |k, _| k == "error" }
  emit["warnings"] = diags.count { |k, _| k == "warning" }
  emit["by_kind"] = diags.group_by { |_, k| k }.transform_values(&:size)
                         .sort_by { |_, n| -n }.to_h
  emit["files"] = log[/(?:wrote|emitted) (\d+) files/, 1]&.to_i
end

# ── The stub ledger ──────────────────────────────────────────────────
# Every entry is something the emit could not do for itself, spliced in
# before the count was taken. A pass rate propped up by the harness is
# not a pass rate about the emit, so the page lists them.
stubs = { "spliced" => !!opts[:stubs] }
if opts[:stubs] && File.exist?(opts[:stubs])
  stubs["file"] = opts[:stubs].sub("#{ROOT}/", "")
  blocks = []
  current = nil
  File.readlines(opts[:stubs]).each do |line|
    if line =~ /^# GAP\b/
      blocks << current if current
      current = [line.sub(/^#\s?/, "").chomp]
    elsif current && line.start_with?("#")
      current << line.sub(/^#\s?/, "").chomp
    elsif current
      blocks << current
      current = nil
    end
  end
  blocks << current if current
  stubs["entries"] = blocks.map do |b|
    text = b.join(" ").gsub(/\s+/, " ").strip
    why = text.sub(/\AGAP\b/, "").strip
    # Entries open in several shapes — "GAP: x", "GAP ×2, both …: x",
    # "GAP, NEW: x". The qualifier before the colon is bookkeeping; what
    # names the gap comes after it, so the split is on the first colon
    # when there is a plausible qualifier ahead of it.
    lead, rest = why.split(":", 2)
    qualifier = (rest && lead.to_s.length <= 160) ? lead.sub(/\AGAP\b/, "").strip.sub(/\A[,—-]+\s*/, "") : ""
    src = (rest && lead.to_s.length <= 160) ? rest.strip : why.sub(/\A[\s,:—-]+/, "")
    src = src.sub(/\A\*\s*/, "")  # a multi-gap block opens with a bullet
    # A clause that ends in a sentence break is a whole name; anything
    # longer is cut at a word and marked as cut.
    if (whole = src[/\A.{0,110}?(?=\. |\z)/])
      head = whole
      tail = src[whole.length..].to_s.sub(/\A\.\s*/, "")
    else
      keep = (cut = src[0, 110])[0, cut.rindex(" ") || 110].rstrip
      head = "#{keep}…"
      # A CUT head is not a duplicate of the text it was cut from — the
      # ellipsis promises the rest — and resuming mid-sentence reads as
      # garble, so the why carries the whole thing.
      tail = src
    end
    # The head NAMES the gap and is rendered as the row's label, so the
    # why is what is LEFT of the comment after it. Printing the whole
    # comment here made every row read its own name twice, the second
    # time behind a stray colon. A qualifier ahead of the colon ("×2,
    # both compiler gaps …") is real context, not bookkeeping, so it
    # survives as a lead-in.
    why = [qualifier.empty? ? nil : "#{qualifier.sub(/[.\s]+\z/, "")}.", tail]
          .compact.reject(&:empty?).join(" ")
    { "what" => head.strip, "why" => why.empty? ? head.strip : why }
  end
  stubs["count"] = stubs["entries"].size
end

# ── Provenance ───────────────────────────────────────────────────────
app = { "name" => opts[:app], "repo" => recipe["repo"], "pinned" => true }
app["path"] = opts[:app_path] if opts[:app_path]
app["sha"] = opts[:sha] || (opts[:app_path] && git(opts[:app_path], "rev-parse", "HEAD"))
rh = {
  "sha" => git(ROOT, "rev-parse", "HEAD"),
  "dirty" => !git(ROOT, "status", "--porcelain", "--untracked-files=no").to_s.empty?,
}

# ── The compiler, on the lane that has one ───────────────────────────
# WITHOUT THIS A RED NIGHT CANNOT BE ATTRIBUTED. The other three inputs
# are stable by construction — the app is pinned, roundhouse is this
# checkout, ruby is this interpreter — but the spinel lane's compiler is
# whatever the publisher pulled and built that morning, and it moves
# without anyone here touching it (b80f6302 -> fc866b04 -> aff3815f
# inside one session). A number that drops overnight is either ours or
# the compiler's, and nothing else in this summary can tell those apart.
#
# READ FROM THE BINARY, NOT FROM A CHECKOUT. `spinel --version` prints
# the commit compiled INTO it (`spinel ba502fba0092 (unreleased) [...]`),
# which is the compiler that actually built these tests. A `git -C
# ~/spinel rev-parse HEAD` answers what the tree is NOW: after a
# `git pull && make` whose make failed, that is a commit this run never
# used, and it would pin the blame on an innocent one.
#
# `null` on the ruby lane, which has no compiler, and a record with
# `null` fields on the spinel lane when the binary cannot be run — so
# "this lane has no compiler" and "this lane has one and I could not
# read it" stay distinguishable in the JSON.
#
# RESCUED, because `spinel` is not a dependency of this script the way
# git and sqlite3 are: the ruby lane never needs it, so a box without it
# on PATH is a legitimate configuration. `Open3.capture3` raises
# Errno::ENOENT rather than reporting failure, and an unrescued raise
# here would lose a completed sweep at the last step — the same way an
# undecodable byte in a compile error did.
spinel = nil
if opts[:target] == "spinel"
  line =
    begin
      out, _, st = Open3.capture3("spinel", "--version")
      st.success? ? out.strip : nil
    rescue SystemCallError
      nil
    end
  spinel = {
    "version" => line,
    # The bare commit, for a page or a floor that wants to compare two
    # runs without parsing the whole banner. The banner has had two
    # shapes — `spinel ba502fba0092 (unreleased) [...]` and, since the
    # dated releases, `spinel 2026.09.12+15 (8720b90f) [...]` — and the
    # report treats a missing sha as a missing compiler, so a parse that
    # knows only one shape raises the alarm on every clean run.
    "sha" => line && (line[/\bspinel\s+([0-9a-f]{7,40})\b/, 1] ||
                      line[/\(([0-9a-f]{7,40})\)/, 1]),
  }
end

files_green = by_file.count { |f| f["status"] == "pass" }
# The compiled lane runs the same emitted Ruby as the interpreted one, so
# every difference between two summaries with the same app SHA is the
# COMPILER's, not the app's. Only this lane has a `build` row.
lane = {
  "target" => opts[:target],
  "runner" => opts[:target] == "spinel" ?
    "each test file compiled to its own native binary by spinel, then run" :
    "each test file run by CRuby",
}
out = {
  "generated_at" => Time.now.utc.iso8601,
  "lane" => lane,
  "app" => app,
  "roundhouse" => rh,
  "ruby" => { "version" => RUBY_VERSION },
  "spinel" => spinel,
  "emit" => emit,
  "stubs" => stubs,
  "attribution" => {
    "per_test" => have_fail_log,
    "note" => (!have_fail_log ?
      "No --fail-log for this run: every unpassed test is attributed to its file's first error, " \
      "which over-credits the first wall in each file." :
      "Each unpassed test carries its own message; a file that never ran contributes its whole " \
      "count against its load error.") +
      (env.empty? ? "" : " #{env.size} test(s) fail on Rails too and are set aside as environment, " \
                         "not charged to a cause."),
  },
  "tests" => {
    "total" => by_file.sum { |f| f["tests"] },
    "passed" => by_file.sum { |f| f["passed"] },
    "failed" => by_file.sum { |f| f["failed"] },
  },
  "rows" => rows,
  "baseline" => baseline_meta,
  "dropped" => dropped,
  "env" => env,
  "extra" => extra,
  "files" => {
    "total" => by_file.size,
    "green" => files_green,
    "aborted" => by_file.count { |f| f["aborted"] },
    # Files that never LINKED — a spinel-lane row, and the number the
    # compiled lane should be read by first: a file that did not compile
    # has said nothing about whether the emit is correct.
    "unbuilt" => by_file.count { |f| f["status"] == "build" },
  },
  "scope" => {
    "note" => "Every test file the app's own suite declares, read from the emitted Makefile's " \
              "SPINEL_TESTS rather than restated here — a `find test -name '*_test.rb'` would " \
              "also sweep in the scaffold's own tests, which are not the app's.",
  },
  "causes" => causes,
  "by_file" => by_file.sort_by { |f| [-f["failed"], f["file"]] },
}

require "fileutils"
FileUtils.mkdir_p(File.dirname(opts[:out]))
File.write(opts[:out], JSON.pretty_generate(out))
warn "app-suite-summary: wrote #{opts[:out]}"
unbuilt = out["files"]["unbuilt"]
warn "  #{out["tests"]["passed"]}/#{out["tests"]["total"]} tests · " \
     "#{files_green}/#{by_file.size} files green · " \
     "#{unbuilt.zero? ? "" : "#{unbuilt} never linked · "}" \
     "#{unpassed_total} unpassed across " \
     "#{causes.count { |c| c["failures"] > 0 }} cause(s)" \
     "#{rows ? " · #{rows["dropped"]} dropped, #{rows["env"]} env" : ""}"
